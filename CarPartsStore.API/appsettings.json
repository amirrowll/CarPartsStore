{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=carpartsstore.db"
  },
  "JwtSettings": {
    "SecretKey": "CHANGE_THIS_TO_A_VERY_STRONG_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "CarPartsStoreAPI",
    "Audience": "CarPartsStoreClient",
    "ExpiryInMinutes": 60
  },
  "AllowedHosts": "*;localhost;127.0.0.1;0.0.0.0",
  "SiteUrl": "https://pinparts.ir",
  "AllowedOrigins": [
    "http://localhost:5173",
    "http://127.0.0.1:5173",
    "http://localhost:5000",
    "http://127.0.0.1:5000",
    "https://pinparts.ir"
  ],
  "PaymentSettings": {
    "ZarinpalMerchantId": "YOUR_MERCHANT_ID",
    "SandboxMode": true
  },
  "EmailSettings": {
    "AdminEmail": "pinparts.ir@gmail.com",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "EnableSsl": true,
    "SenderName": "سیستم استعلام پین‌پارت",
    "SenderEmail": "no-reply@pinparts.ir"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
