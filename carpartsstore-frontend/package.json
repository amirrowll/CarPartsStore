{
  "name": "Pinpart-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "tsc -p tsconfig.build.json && vite build",
    "build:full": "vite build && node create-favicons.cjs",
    "build:analyze": "vite build && node scripts/optimize-build.cjs",
    "build:optimized": "npm run optimize:images && vite build",
    "build:deploy": "node scripts/deploy-optimizations.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "favicons": "node create-favicons.cjs",
    "lighthouse": "npx lighthouse http://localhost:5173 --output html --output-path ./lighthouse-report.html --view",
    "lighthouse:prod": "npx lighthouse https://pinparts.ir --output html --output-path ./lighthouse-report-prod.html --view",
    "optimize:images": "node optimize-images.cjs",
    "optimize:build": "node scripts/optimize-build.cjs",
    "performance:check": "node scripts/performance-check.cjs",
    "deploy:prepare": "npm run optimize:images && npm run build:deploy",
    "optimize:all": "node scripts/run-all-optimizations.cjs",
    "test:optimizations": "node scripts/test-optimizations.cjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "axios": "^1.16.1",
    "lucide-react": "^1.16.0",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^14.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.15.1",
    "swiper": "^12.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.19",
    "canvas": "^3.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "lighthouse": "^12.1.0",
    "postcss": "^8.4.38",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.0",
    "terser": "^5.51.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-compression": "^0.5.1"
  }
}
